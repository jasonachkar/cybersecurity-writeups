{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateDelegatedRoleOnlyWithApprovedBoundary",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::111122223333:role/delegated/*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::111122223333:policy/DelegatedWorkloadBoundary"
        }
      }
    },
    {
      "Sid": "ManagePoliciesOnlyOnDelegatedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::111122223333:role/delegated/*"
    },
    {
      "Sid": "DenyBoundaryRemovalOrReplacement",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::111122223333:role/delegated/*"
    }
  ]
}
