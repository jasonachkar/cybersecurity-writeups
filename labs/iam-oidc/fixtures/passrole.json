{
  "kind": "aws-authorization",
  "identityPolicy": "restricted-passrole.json",
  "destinationTrustPolicy": "ecs-payments-task-trust.json",
  "cases": [
    {
      "name": "pass the exact task role to ECS for the payments task definition",
      "request": {
        "action": "iam:PassRole",
        "resource": "arn:aws:iam::111122223333:role/service/ecs/payments-task",
        "context": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com",
          "iam:AssociatedResourceArn": "arn:aws:ecs:ca-central-1:111122223333:task-definition/payments-api"
        }
      },
      "expectedAllowed": true
    },
    {
      "name": "pass another role",
      "request": {
        "action": "iam:PassRole",
        "resource": "arn:aws:iam::111122223333:role/security-admin",
        "context": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com",
          "iam:AssociatedResourceArn": "arn:aws:ecs:ca-central-1:111122223333:task-definition/payments-api"
        }
      },
      "expectedAllowed": false
    },
    {
      "name": "pass the task role to another service",
      "request": {
        "action": "iam:PassRole",
        "resource": "arn:aws:iam::111122223333:role/service/ecs/payments-task",
        "context": {
          "iam:PassedToService": "lambda.amazonaws.com",
          "iam:AssociatedResourceArn": "arn:aws:ecs:ca-central-1:111122223333:task-definition/payments-api"
        }
      },
      "expectedAllowed": false
    },
    {
      "name": "associate the role with another task-definition family",
      "request": {
        "action": "iam:PassRole",
        "resource": "arn:aws:iam::111122223333:role/service/ecs/payments-task",
        "context": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com",
          "iam:AssociatedResourceArn": "arn:aws:ecs:ca-central-1:111122223333:task-definition/admin-api"
        }
      },
      "expectedAllowed": false
    }
  ]
}
