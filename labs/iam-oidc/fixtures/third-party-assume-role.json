{
  "kind": "aws-assume-role",
  "trustPolicy": "third-party-trust.json",
  "base": {
    "callerAuthenticated": true,
    "principalArn": "arn:aws:iam::444455556666:role/vendor-exporter",
    "externalId": "example-tenant-a-7a7a7a7a-0000-4000-8000-000000000000",
    "sessionTags": {
      "tenant-id": "tenant-a",
      "workload": "billing-export"
    }
  },
  "cases": [
    {
      "name": "exact vendor principal external ID and constrained tags are authorized",
      "mutations": {},
      "expectedStage": "AUTHORIZED"
    },
    {
      "name": "another vendor principal fails role trust",
      "mutations": {
        "principalArn": "arn:aws:iam::444455556666:role/another-role"
      },
      "expectedStage": "TRUST_POLICY_REJECTED"
    },
    {
      "name": "missing customer external ID fails role trust",
      "mutations": {
        "externalId": null
      },
      "expectedStage": "TRUST_POLICY_REJECTED"
    },
    {
      "name": "another customer external ID fails role trust",
      "mutations": {
        "externalId": "example-tenant-b-8b8b8b8b-0000-4000-8000-000000000000"
      },
      "expectedStage": "TRUST_POLICY_REJECTED"
    },
    {
      "name": "another tenant session tag fails role trust",
      "mutations": {
        "sessionTags.tenant-id": "tenant-b"
      },
      "expectedStage": "TRUST_POLICY_REJECTED"
    },
    {
      "name": "an extra unapproved session tag fails TagSession authorization",
      "mutations": {
        "sessionTags.admin": "true"
      },
      "expectedStage": "TRUST_POLICY_REJECTED"
    },
    {
      "name": "missing sts TagSession permission rejects a tagged session",
      "mutations": {
        "trustPolicy.Statement.1.Action": "sts:AssumeRole"
      },
      "expectedStage": "TRUST_POLICY_REJECTED"
    }
  ]
}
