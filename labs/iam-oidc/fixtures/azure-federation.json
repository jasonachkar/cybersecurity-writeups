{
  "kind": "azure-federation",
  "federatedCredential": "azure-github-federated-credential.json",
  "base": {
    "token": {
      "signatureVerified": true,
      "issuer": "https://token.actions.githubusercontent.com",
      "audience": "api://AzureADTokenExchange",
      "subject": "repo:example-security/cloud-controls:environment:production",
      "notBefore": 1899999900,
      "expiresAt": 1900000300
    },
    "claimRequirements": {
      "expectedIssuer": "https://token.actions.githubusercontent.com",
      "expectedAudience": "api://AzureADTokenExchange",
      "now": 1900000000
    },
    "permissionSet": {
      "allowedActions": [
        "Microsoft.Resources/subscriptions/resourceGroups/read"
      ],
      "allowedScopes": [
        "/subscriptions/<subscription-id>/resourceGroups/cloud-controls-production"
      ],
      "request": {
        "action": "Microsoft.Resources/subscriptions/resourceGroups/read",
        "scope": "/subscriptions/<subscription-id>/resourceGroups/cloud-controls-production"
      }
    }
  },
  "cases": [
    {
      "name": "exact issuer audience subject and resource scope are authorized",
      "mutations": {},
      "expectedStage": "AUTHORIZED"
    },
    {
      "name": "invalid token signature is rejected",
      "mutations": {
        "token.signatureVerified": false
      },
      "expectedStage": "SIGNATURE_INVALID"
    },
    {
      "name": "wrong issuer is rejected during claim validation",
      "mutations": {
        "token.issuer": "https://issuer.example.invalid"
      },
      "expectedStage": "CLAIMS_REJECTED"
    },
    {
      "name": "wrong audience is rejected during claim validation",
      "mutations": {
        "token.audience": "sts.amazonaws.com"
      },
      "expectedStage": "CLAIMS_REJECTED"
    },
    {
      "name": "valid token for another GitHub environment fails federated trust",
      "mutations": {
        "token.subject": "repo:example-security/cloud-controls:environment:staging"
      },
      "expectedStage": "TRUST_POLICY_REJECTED"
    },
    {
      "name": "token exchange succeeds but authorization denies a write",
      "mutations": {
        "permissionSet.request.action": "Microsoft.Resources/subscriptions/resourceGroups/write"
      },
      "expectedStage": "PERMISSIONS_DENIED"
    },
    {
      "name": "token exchange succeeds but authorization denies another resource group",
      "mutations": {
        "permissionSet.request.scope": "/subscriptions/<subscription-id>/resourceGroups/other"
      },
      "expectedStage": "PERMISSIONS_DENIED"
    }
  ]
}
