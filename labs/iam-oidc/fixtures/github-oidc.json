{
  "kind": "aws-web-identity",
  "scenarios": [
    {
      "name": "exact-main-branch",
      "trustPolicy": "aws-github-main-trust.json",
      "base": {
        "token": {
          "signatureVerified": true,
          "issuer": "https://token.actions.githubusercontent.com",
          "audience": "sts.amazonaws.com",
          "subject": "repo:example-security/cloud-controls:ref:refs/heads/main",
          "notBefore": 1899999900,
          "expiresAt": 1900000300
        },
        "claimRequirements": {
          "expectedIssuer": "https://token.actions.githubusercontent.com",
          "expectedAudience": "sts.amazonaws.com",
          "conditionPrefix": "token.actions.githubusercontent.com",
          "now": 1900000000
        },
        "providerArn": "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com",
        "permissionSet": {
          "identityPolicies": [
            "github-role-permissions.json"
          ],
          "boundary": "github-role-boundary.json",
          "request": {
            "action": "s3:PutObject",
            "resource": "arn:aws:s3:::example-security-release-artifacts/production/release.tgz",
            "context": {}
          }
        }
      },
      "cases": [
        {
          "name": "exact repository and main branch may write a release object",
          "mutations": {},
          "expectedStage": "AUTHORIZED"
        },
        {
          "name": "invalid signature stops before claim evaluation",
          "mutations": {
            "token.signatureVerified": false
          },
          "expectedStage": "SIGNATURE_INVALID"
        },
        {
          "name": "valid signature with the wrong issuer fails claim validation",
          "mutations": {
            "token.issuer": "https://issuer.example.invalid"
          },
          "expectedStage": "CLAIMS_REJECTED"
        },
        {
          "name": "valid signature with the wrong audience fails claim validation",
          "mutations": {
            "token.audience": "api://AzureADTokenExchange"
          },
          "expectedStage": "CLAIMS_REJECTED"
        },
        {
          "name": "expired token fails claim validation",
          "mutations": {
            "token.expiresAt": 1899999999
          },
          "expectedStage": "CLAIMS_REJECTED"
        },
        {
          "name": "valid claims from another repository fail role trust",
          "mutations": {
            "token.subject": "repo:example-security/another-repo:ref:refs/heads/main"
          },
          "expectedStage": "TRUST_POLICY_REJECTED"
        },
        {
          "name": "valid claims from another branch fail role trust",
          "mutations": {
            "token.subject": "repo:example-security/cloud-controls:ref:refs/heads/feature"
          },
          "expectedStage": "TRUST_POLICY_REJECTED"
        },
        {
          "name": "claims accepted but an untrusted provider ARN fails role trust",
          "mutations": {
            "providerArn": "arn:aws:iam::111122223333:oidc-provider/issuer.example.invalid"
          },
          "expectedStage": "TRUST_POLICY_REJECTED"
        },
        {
          "name": "role is assumed but the permission boundary denies object deletion",
          "mutations": {
            "permissionSet.request.action": "s3:DeleteObject"
          },
          "expectedStage": "PERMISSIONS_DENIED"
        },
        {
          "name": "role is assumed but resource scope denies another prefix",
          "mutations": {
            "permissionSet.request.resource": "arn:aws:s3:::example-security-release-artifacts/development/release.tgz"
          },
          "expectedStage": "PERMISSIONS_DENIED"
        }
      ]
    },
    {
      "name": "exact-production-environment",
      "trustPolicy": "aws-github-production-trust.json",
      "base": {
        "token": {
          "signatureVerified": true,
          "issuer": "https://token.actions.githubusercontent.com",
          "audience": "sts.amazonaws.com",
          "subject": "repo:example-security/cloud-controls:environment:production",
          "notBefore": 1899999900,
          "expiresAt": 1900000300
        },
        "claimRequirements": {
          "expectedIssuer": "https://token.actions.githubusercontent.com",
          "expectedAudience": "sts.amazonaws.com",
          "conditionPrefix": "token.actions.githubusercontent.com",
          "now": 1900000000
        },
        "providerArn": "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com",
        "permissionSet": {
          "identityPolicies": [
            "github-role-permissions.json"
          ],
          "boundary": "github-role-boundary.json",
          "request": {
            "action": "s3:GetObject",
            "resource": "arn:aws:s3:::example-security-release-artifacts/production/release.tgz",
            "context": {}
          }
        }
      },
      "cases": [
        {
          "name": "exact repository and production environment may read a release object",
          "mutations": {},
          "expectedStage": "AUTHORIZED"
        },
        {
          "name": "branch subject does not satisfy environment trust",
          "mutations": {
            "token.subject": "repo:example-security/cloud-controls:ref:refs/heads/main"
          },
          "expectedStage": "TRUST_POLICY_REJECTED"
        },
        {
          "name": "another environment does not satisfy production trust",
          "mutations": {
            "token.subject": "repo:example-security/cloud-controls:environment:staging"
          },
          "expectedStage": "TRUST_POLICY_REJECTED"
        }
      ]
    }
  ]
}
