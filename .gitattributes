# Keep shell scripts LF so ShellCheck and bash behave the same on Windows and CI.
*.sh text eol=lf

# The gh-pages artifact is generated by scripts/maintain-gh-pages.mjs, which writes
# LF-only output deterministically. Without this, core.autocrlf=true on Windows
# checks these back out as CRLF, and the next `npm run maintain` run produces a
# mixed-line-ending diff purely from checkout state, not from any real content change.
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.mjs text eol=lf
*.js text eol=lf

# gofmt is byte-strict about line endings; without this, a Windows checkout of the
# pre-existing Go modules under appsec/scripts, cloud-security/scripts, and
# threat-intel/scripts fails `npm run verify:go` purely from checkout state.
*.go text eol=lf
