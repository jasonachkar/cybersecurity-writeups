{
  "name": "cybersecurity-writeups-quality",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic content and security-example validation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "index:generate": "node scripts/generate-index.js && node scripts/generate-content-inventory.js",
    "generated:check": "node scripts/check-generated.js",
    "metadata:check": "node scripts/validate-metadata.js",
    "freshness:check": "node scripts/check-freshness.js",
    "research:check": "node scripts/validate-research-structure.js",
    "code:check": "node scripts/validate-code-examples.js",
    "actions:check": "node scripts/check-action-pins.js",
    "links:check": "node scripts/check-links.js",
    "links:external": "node scripts/check-links.js --external",
    "markdown:check": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#mkdocs-project/docs\" \"#qa\" \"#qa-artifacts\" \"#.artifacts\"",
    "labs:test": "node labs/secure-cicd/tests/run-tests.js && node labs/supply-chain/tests/run-tests.js",
    "docs:pipeline:test": "cd tools/docs-pipeline && go test ./...",
    "docs:inventory": "go run ./tools/docs-pipeline/main.go inventory",
    "docs:audit": "go run ./tools/docs-pipeline/main.go audit -published-ref origin/gh-pages",
    "docs:build": "go run ./tools/docs-pipeline/main.go build -python python3",
    "docs:verify": "go run ./tools/docs-pipeline/main.go verify -site .artifacts/site",
    "validate": "npm run markdown:check && npm run generated:check && npm run metadata:check && npm run freshness:check && npm run research:check && npm run actions:check && npm run code:check && npm run links:check && npm run labs:test"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.1",
    "yaml": "2.9.0"
  }
}
