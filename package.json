{
  "name": "cybersecurity-writeups-gh-pages",
  "private": true,
  "version": "1.0.0",
  "description": "Deterministic maintenance and validation for the deployed gh-pages portfolio",
  "type": "module",
  "scripts": {
    "maintain": "node scripts/maintain-gh-pages.mjs",
    "check:defects": "node scripts/check-known-defects.mjs",
    "validate": "node scripts/validate-gh-pages.mjs && node scripts/run-html-validation.mjs && node scripts/check-known-defects.mjs",
    "validate:html": "node scripts/run-html-validation.mjs",
    "check:external": "node scripts/check-external-links.mjs",
    "audit:a11y": "node scripts/run-accessibility-audit.mjs",
    "verify:static": "node scripts/verify.mjs static",
    "verify:node": "node scripts/verify.mjs labs",
    "verify:go": "node scripts/verify.mjs go",
    "verify:terraform": "node scripts/verify.mjs terraform",
    "verify:opa": "node scripts/verify.mjs opa",
    "verify:bicep": "node scripts/verify.mjs bicep",
    "verify:policy-schemas": "node scripts/verify.mjs policy-schemas",
    "verify:kyverno": "node scripts/verify.mjs kyverno",
    "verify:postgresql": "node scripts/verify.mjs postgres",
    "verify:shell": "node scripts/verify.mjs shell",
    "verify:powershell": "node scripts/verify.mjs powershell",
    "verify:a11y": "node scripts/run-accessibility-audit.mjs",
    "verify:links": "node scripts/verify.mjs links",
    "verify:secrets": "node scripts/verify.mjs secrets",
    "verify:summary": "node scripts/stamp-qa-reports.mjs summary",
    "verify:provenance": "node scripts/verify-qa-provenance.mjs",
    "verify:all": "node scripts/verify.mjs all"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "html-validate": "11.5.6",
    "playwright": "1.61.1"
  }
}
