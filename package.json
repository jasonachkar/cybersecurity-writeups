{
  "name": "cybersecurity-writeups-quality",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic content and security-example validation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "index:generate": "node scripts/generate-index.js && node scripts/generate-content-inventory.js",
    "generated:check": "node scripts/check-generated.js",
    "metadata:check": "node scripts/validate-metadata.js",
    "freshness:check": "node scripts/check-freshness.js",
    "research:check": "node scripts/validate-research-structure.js",
    "code:check": "node scripts/validate-code-examples.js",
    "actions:check": "node scripts/check-action-pins.js",
    "links:check": "node scripts/check-links.js",
    "links:external": "node scripts/check-links.js --external",
    "markdown:check": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#mkdocs-project/docs\" \"#qa\" \"#qa-artifacts\" \"#.artifacts\"",
    "labs:test": "node labs/secure-cicd/tests/run-tests.js && node labs/supply-chain/tests/run-tests.js",
    "docs:pipeline:test": "cd tools/docs-pipeline && go test ./...",
    "docs:inventory": "go run ./tools/docs-pipeline/main.go inventory",
    "docs:audit": "go run ./tools/docs-pipeline/main.go audit -published-ref origin/gh-pages",
    "docs:catalog": "node scripts/render-docs-data.mjs --check",
    "docs:catalog:test": "node --test scripts/docs-catalog-lib.test.js",
    "docs:build": "go run ./tools/docs-pipeline/main.go build -python .venv/bin/python",
    "docs:serve": "go run ./tools/docs-pipeline/main.go serve -python .venv/bin/python",
    "docs:verify": "go run ./tools/docs-pipeline/main.go verify -site .artifacts/site",
    "docs:test:html": "node tests/docs/html.test.mjs",
    "docs:test:ui": "node tests/docs/ui.test.mjs",
    "docs:test:a11y": "node tests/docs/accessibility.test.mjs",
    "docs:test:visual": "playwright test tests/docs/visual.spec.mjs",
    "docs:update-snapshots": "playwright test tests/docs/visual.spec.mjs --update-snapshots",
    "research:new": "node scripts/research-new.js",
    "research:new:test": "node --test scripts/research-new.test.js",
    "verify:docs": "npm run docs:pipeline:test && npm run docs:catalog && npm run docs:build && npm run docs:test:html && npm run docs:test:ui && npm run docs:test:a11y && npm run docs:test:visual",
    "verify:all": "npm run validate && npm run verify:docs",
    "validate": "npm run markdown:check && npm run generated:check && npm run metadata:check && npm run freshness:check && npm run research:check && npm run actions:check && npm run code:check && npm run links:check && npm run labs:test && npm run research:new:test && npm run docs:catalog:test && npm run docs:catalog"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "html-validate": "11.5.6",
    "markdownlint-cli2": "^0.23.2",
    "mermaid": "^11.16.1",
    "playwright": "1.61.1",
    "shiki": "4.4.3",
    "yaml": "2.9.0"
  }
}
